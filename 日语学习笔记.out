    },
    "three-slopes": {
      "id": "three-slopes",
      "parentId": "culture",
      "children": [],
      "text": "人生には三つの坂があるんですって。上り坂、下り坂、まさか。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "坂（さか）与まさか（没想到）的谐音",
      "images": []
    }
