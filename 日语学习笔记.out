    "ningyou": {
      "id": "ningyou",
      "parentId": "vocabulary",
      "children": [
        "figure",
        "nuigurumi"
      ],
      "text": "人形（にんぎょう）：人偶、玩偶",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "普通“人偶”的通用说法",
      "images": []
    },
    "figure": {
      "id": "figure",
      "parentId": "ningyou",
      "children": [],
      "text": "フィギュア：动漫或游戏手办",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "nuigurumi": {
      "id": "nuigurumi",
      "parentId": "ningyou",
      "children": [],
      "text": "ぬいぐるみ：毛绒玩偶",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "annai": {
      "id": "annai",
      "parentId": "vocabulary",
      "children": [],
      "text": "案内（あんない）：引导、带路、介绍",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "道を案内する：带路",
      "images": []
    },
    "angai": {
      "id": "angai",
      "parentId": "vocabulary",
      "children": [],
      "text": "案外（あんがい）：意外地、没想到",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "案外簡単だった：没想到还挺简单",
      "images": []
    },
    "soft-drink": {
      "id": "soft-drink",
      "parentId": "vocabulary",
      "children": [],
      "text": "ソフトドリンク：软饮料、非酒精饮料",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "来自英语 soft drink。菜单常见：ソフトドリンク飲み放題。",
      "images": []
    },
    "seiryo-inryosui": {
      "id": "seiryo-inryosui",
      "parentId": "vocabulary",
      "children": [],
      "text": "清涼飲料水（せいりょういんりょうすい）：清凉饮料",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "较正式、书面或商品分类用语；日常更常说ソフトドリンク。",
      "images": []
    },
    "tokkyoken": {
      "id": "tokkyoken",
      "parentId": "vocabulary",
      "children": [],
      "text": "特許権（とっきょけん）：专利权",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律语境中常和効力が及ぶ、侵害する、有効である搭配。",
      "images": []
    },
    "zokuchi-shugi": {
      "id": "zokuchi-shugi",
      "parentId": "vocabulary",
      "children": [],
      "text": "属地主義（ぞくちしゅぎ）：属地主义",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律效力原则上只在本国领土范围内发生作用。",
      "images": []
    },
    "koryoku-oyobu": {
      "id": "koryoku-oyobu",
      "parentId": "vocabulary",
      "children": [],
      "text": "効力が及ぶ（こうりょくがおよぶ）：效力及于、适用于",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律、规则、权利的效力覆盖到某对象。例：法律の効力は海外には及ばない。",
      "images": []
    },
    "souten": {
      "id": "souten",
      "parentId": "vocabulary",
      "children": [],
      "text": "争点（そうてん）：争议焦点",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "争点になる：成为争议点、问题焦点。",
      "images": []
    },
    "wazuka-bakari": {
      "id": "wazuka-bakari",
      "parentId": "vocabulary",
      "children": [],
      "text": "わずかばかり：仅仅一点点、少得可怜",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "わずか＋ばかり；不只是客观少，也可带轻视或否定评价。",
      "images": []
    },
    "enmei": {
      "id": "enmei",
      "parentId": "vocabulary",
      "children": [],
      "text": "延命（えんめい）：延长生命、续命",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "常见搭配：延命治療（えんめいちりょう）：延命治疗。",
      "images": []
    },
    "igi": {
      "id": "igi",
      "parentId": "vocabulary",
      "children": [],
      "text": "意義（いぎ）：意义、价值",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "意義がある：有意义、有价值。意義はあるのだろうか：真的有意义吗？",
      "images": []
    },
    "sei": {
      "id": "sei",
      "parentId": "vocabulary",
      "children": [],
      "text": "生（せい）：生命、生存",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "加引号的「生」常指抽象、哲学意义上的生命或活着这件事。",
      "images": []
    },
    "shigamitsuku": {
      "id": "shigamitsuku",
      "parentId": "vocabulary",
      "children": [],
      "text": "しがみつく：紧紧抓住、执着不放",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "可指物理上抓住，也可指心理执念。生にしがみつく：执着于活下去。",
      "images": []
    },
    "grammar": {
      "id": "grammar",
      "parentId": "jp-root",
      "children": [
        "temiru",
        "naitoikenai",
