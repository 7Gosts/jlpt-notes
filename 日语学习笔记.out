      ],
      "text": "语法",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "temiru": {
      "id": "temiru",
      "parentId": "grammar",
      "children": [],
      "text": "～てみる：试着做……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "リサーチしてみる：试着调查一下",
      "images": []
    },
    "naitoikenai": {
      "id": "naitoikenai",
      "parentId": "grammar",
      "children": [],
      "text": "～ないといけない：必须……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "如果不做就不行；口语：～ないと／～なきゃ",
      "images": []
    },
    "tekureru": {
      "id": "tekureru",
      "parentId": "grammar",
      "children": [],
      "text": "～てくれる：别人为我方做某事",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "聞いてくれてサンキュー：谢谢你问我／听我说",
      "images": []
    },
    "teshimau": {
      "id": "teshimau",
      "parentId": "grammar",
      "children": [],
      "text": "～てしまう：不由得……／做完了",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "口语：～ちゃう；興奮してしまって → 興奮しちゃって",
      "images": []
    },
    "younimieru": {
      "id": "younimieru",
      "parentId": "grammar",
      "children": [],
      "text": "～ように見える：看起来像……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "ふざけてるように見える：看起来像在开玩笑",
      "images": []
    },
    "kamoshirenai": {
      "id": "kamoshirenai",
      "parentId": "grammar",
      "children": [],
      "text": "～かもしれない：也许、可能",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "nanda": {
      "id": "nanda",
      "parentId": "grammar",
      "children": [],
      "text": "～んだ／～なんだ：解释或强调",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "この想いは本気なんだ：这份心意是认真的。なぜ～んだね：追问理由，带审视或质问语气。",
      "images": []
    },
    "monode": {
      "id": "monode",
      "parentId": "grammar",
      "children": [],
      "text": "～もので：委婉说明原因",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "口语形式：～もんで",
      "images": []
    },
    "nomi": {
      "id": "nomi",
      "parentId": "grammar",
      "children": [],
      "text": "～のみ：仅、只",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "比だけ更书面、正式。日本国内でのみ有効：只在日本国内有效。",
      "images": []
    },
    "tosareru": {
      "id": "tosareru",
      "parentId": "grammar",
      "children": [],
      "text": "～とされる：被认为是、被视为",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "常见于新闻、法律、论文。例：有効とされる：被认为有效。",
      "images": []
    },
    "kotokara": {
      "id": "kotokara",
      "parentId": "grammar",
      "children": [],
      "text": "～ことから：由于、基于……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "书面说明原因或判断依据。例：サーバーがアメリカにあることから。",
      "images": []
    },
    "nokadouka": {
      "id": "nokadouka",
      "parentId": "grammar",
      "children": [],
      "text": "～のかどうか：是否……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "把疑问内容名词化。効力が及ぶのかどうか：效力是否及于。",
      "images": []
    },
    "nodarouka": {
      "id": "nodarouka",
      "parentId": "grammar",
      "children": [],
      "text": "～のだろうか：究竟是否……呢",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "带沉思、怀疑或反问感。意義はあるのだろうか：真的有意义吗？",
      "images": []
    },
    "conjugation": {
      "id": "conjugation",
      "parentId": "jp-root",
