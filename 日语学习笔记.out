    "temiru": {
      "id": "temiru",
      "parentId": "grammar",
      "children": [],
      "text": "～てみる：试着做……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "リサーチしてみる：试着调查一下",
      "images": []
    },
    "naitoikenai": {
      "id": "naitoikenai",
      "parentId": "grammar",
      "children": [],
      "text": "～ないといけない：必须……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "如果不做就不行；口语：～ないと／～なきゃ",
      "images": []
    },
    "tekureru": {
      "id": "tekureru",
      "parentId": "grammar",
      "children": [],
      "text": "～てくれる：别人为我方做某事",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "聞いてくれてサンキュー：谢谢你问我／听我说",
      "images": []
    },
    "teshimau": {
      "id": "teshimau",
      "parentId": "grammar",
      "children": [],
      "text": "～てしまう：不由得……／做完了",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "口语：～ちゃう；興奮してしまって → 興奮しちゃって",
      "images": []
    },
    "younimieru": {
      "id": "younimieru",
      "parentId": "grammar",
      "children": [],
      "text": "～ように見える：看起来像……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "ふざけてるように見える：看起来像在开玩笑",
      "images": []
    },
    "kamoshirenai": {
      "id": "kamoshirenai",
      "parentId": "grammar",
      "children": [],
      "text": "～かもしれない：也许、可能",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "nanda": {
      "id": "nanda",
      "parentId": "grammar",
      "children": [],
      "text": "～んだ／～なんだ：解释或强调",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "この想いは本気なんだ：这份心意是认真的",
      "images": []
    },
    "monode": {
      "id": "monode",
      "parentId": "grammar",
      "children": [],
