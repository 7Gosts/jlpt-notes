    "sentence-value": {
      "id": "sentence-value",
      "parentId": "sentences",
      "children": [],
      "text": "価値がなければ、生きていても意味がない。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "如果没有价值，即使活着也没有意义。～なければ／～ても",
      "images": []
    },
    "sentence-human-value": {
      "id": "sentence-human-value",
      "parentId": "sentences",
      "children": [],
      "text": "克服できない僕に、人間としての価値はあるのか？",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "无法克服它的我，还有作为人的价值吗？",
      "images": []
    },
    "sentence-neighborhood": {
      "id": "sentence-neighborhood",
      "parentId": "sentences",
      "children": [],
      "text": "ちょうど近所まで来たもので、これどうぞ。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "正好来到附近，这个请收下。来た读作きた。",
      "images": []
    },
    "sentence-research": {
      "id": "sentence-research",
      "parentId": "sentences",
      "children": [],
      "text": "ちょっとリサーチしてみるよ。……この想いは本気なんだ。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "表现得像在开玩笑，但这份感情是认真的。",
      "images": []
    },
    "culture": {
      "id": "culture",
      "parentId": "jp-root",
      "children": [
