      ],
      "text": "词汇",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "ningyou": {
      "id": "ningyou",
      "parentId": "vocabulary",
      "children": [
        "figure",
        "nuigurumi"
      ],
      "text": "人形｜にんぎょう：人偶、玩偶",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "普通“人偶”的通用说法",
      "images": []
    },
    "figure": {
      "id": "figure",
      "parentId": "ningyou",
      "children": [],
      "text": "フィギュア：动漫或游戏手办",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "nuigurumi": {
      "id": "nuigurumi",
      "parentId": "ningyou",
      "children": [],
      "text": "ぬいぐるみ：毛绒玩偶",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "annai": {
      "id": "annai",
      "parentId": "vocabulary",
      "children": [],
      "text": "案内｜あんない：引导、带路、介绍",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "道を案内する：带路",
      "images": []
    },
    "angai": {
      "id": "angai",
      "parentId": "vocabulary",
      "children": [],
      "text": "案外｜あんがい：意外地、没想到",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "案外簡単だった：没想到还挺简单",
      "images": []
    },
    "soft-drink": {
      "id": "soft-drink",
      "parentId": "vocabulary",
      "children": [],
      "text": "ソフトドリンク：软饮料、非酒精饮料",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "来自英语 soft drink。菜单常见：ソフトドリンク飲み放題。",
      "images": []
    },
    "seiryo-inryosui": {
      "id": "seiryo-inryosui",
      "parentId": "vocabulary",
      "children": [],
      "text": "清涼飲料水｜せいりょういんりょうすい：清凉饮料",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "较正式、书面或商品分类用语；日常更常说ソフトドリンク。",
      "images": []
    },
    "tokkyoken": {
      "id": "tokkyoken",
      "parentId": "vocabulary",
      "children": [],
      "text": "特許権｜とっきょけん：专利权",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律语境中常和効力が及ぶ、侵害する、有効である搭配。",
      "images": []
    },
    "zokuchi-shugi": {
      "id": "zokuchi-shugi",
      "parentId": "vocabulary",
      "children": [],
      "text": "属地主義｜ぞくちしゅぎ：属地主义",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律效力原则上只在本国领土范围内发生作用。",
      "images": []
    },
    "koryoku-oyobu": {
      "id": "koryoku-oyobu",
      "parentId": "vocabulary",
      "children": [],
      "text": "効力が及ぶ｜こうりょくがおよぶ：效力及于、适用于",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律、规则、权利的效力覆盖到某对象。例：法律の効力は海外には及ばない。",
      "images": []
    },
    "souten": {
      "id": "souten",
      "parentId": "vocabulary",
      "children": [],
      "text": "争点｜そうてん：争议焦点",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "争点になる：成为争议点、问题焦点。",
      "images": []
    },
    "wazuka-bakari": {
      "id": "wazuka-bakari",
      "parentId": "vocabulary",
      "children": [],
      "text": "わずかばかり：仅仅一点点、少得可怜",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "わずか＋ばかり；不只是客观少，也可带轻视或否定评价。",
      "images": []
    },
    "enmei": {
      "id": "enmei",
      "parentId": "vocabulary",
      "children": [],
      "text": "延命｜えんめい：延长生命、续命",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "常见搭配：延命治療｜えんめいちりょう：延命治疗。",
      "images": []
    },
    "igi": {
      "id": "igi",
      "parentId": "vocabulary",
      "children": [],
      "text": "意義｜いぎ：意义、价值",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "意義がある：有意义、有价值。意義はあるのだろうか：真的有意义吗？",
      "images": []
    },
    "sei": {
      "id": "sei",
      "parentId": "vocabulary",
      "children": [],
      "text": "生｜せい：生命、生存",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "加引号的「生」常指抽象、哲学意义上的生命或活着这件事。",
      "images": []
    },
    "shigamitsuku": {
      "id": "shigamitsuku",
      "parentId": "vocabulary",
      "children": [],
      "text": "しがみつく：紧紧抓住、执着不放",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "可指物理上抓住，也可指心理执念。生にしがみつく：执着于活下去。",
      "images": []
    },
    "kokufuku": {
      "id": "kokufuku",
      "parentId": "vocabulary",
      "children": [],
      "text": "克服｜こくふく：克服",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "弱点を克服する：克服弱点。克服できない：无法克服。",
      "images": []
    },
    "kachi": {
      "id": "kachi",
      "parentId": "vocabulary",
      "children": [],
      "text": "価値｜かち：价值",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "価値がある／ない：有／没有价值。人間としての価値：作为人的价值。",
      "images": []
    },
    "seihin": {
      "id": "seihin",
      "parentId": "vocabulary",
      "children": [],
      "text": "製品｜せいひん：产品、制品",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "比商品更偏“生产出来的物品”。召回、公告中常见。",
      "images": []
    },
    "insatsu-sareru": {
      "id": "insatsu-sareru",
      "parentId": "vocabulary",
      "children": [],
      "text": "印刷されている｜いんさつされている：印有、被印着",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "被动＋ている表示结果状态。製品に印刷されている：印在产品上。",
      "images": []
    },
    "shomi-kigen": {
      "id": "shomi-kigen",
      "parentId": "vocabulary",
      "children": [],
      "text": "賞味期限｜しょうみきげん：赏味期限",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "最佳食用期限，偏品质和风味。",
      "images": []
    },
    "shohi-kigen": {
      "id": "shohi-kigen",
      "parentId": "vocabulary",
      "children": [],
      "text": "消費期限｜しょうひきげん：消费期限、安全食用期限",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "偏安全期限；和賞味期限易混。",
      "images": []
    },
    "tsuzuku": {
      "id": "tsuzuku",
      "parentId": "vocabulary",
      "children": [],
      "text": "続く｜つづく：继续；接在后面",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "続く2文字：后续两个字符。",
      "images": []
    },
    "taisho": {
      "id": "taisho",
      "parentId": "vocabulary",
      "children": [],
      "text": "対象｜たいしょう：对象、范围",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "対象です：属于对象范围。召回语境可译为召回对象。",
      "images": []
    },
    "iryoku-gyomu-bogai": {
      "id": "iryoku-gyomu-bogai",
      "parentId": "vocabulary",
      "children": [],
      "text": "威力業務妨害｜いりょくぎょうむぼうがい：威力业务妨害",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "法律用语；用强硬行为等妨碍他人业务。",
      "images": []
    },
    "utagai": {
      "id": "utagai",
      "parentId": "vocabulary",
      "children": [],
      "text": "疑い｜うたがい：嫌疑、疑问",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "〜の疑いで：因涉嫌……。司法新闻常见。",
      "images": []
    },
    "taihojo": {
      "id": "taihojo",
      "parentId": "vocabulary",
      "children": [],
      "text": "逮捕状｜たいほじょう：逮捕令",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "逮捕状をとる：取得／申请逮捕令。",
      "images": []
    },
    "kokusai-tehai": {
      "id": "kokusai-tehai",
      "parentId": "vocabulary",
      "children": [],
      "text": "国際手配｜こくさいてはい：国际通缉",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "国際手配する：进行国际通缉。",
      "images": []
    },
    "taio": {
      "id": "taio",
      "parentId": "vocabulary",
      "children": [],
      "text": "対応｜たいおう：应对、处理措施",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "対応をとる：采取应对措施。",
      "images": []
    },
    "seijiteki-doki": {
      "id": "seijiteki-doki",
      "parentId": "vocabulary",
      "children": [],
      "text": "政治的な動機｜せいじてきなどうき：政治动机",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "政治的：政治性的、政治方面的。",
      "images": []
    },
    "motodzuku": {
      "id": "motodzuku",
      "parentId": "vocabulary",
      "children": [],
      "text": "基づく｜もとづく：基于、根据",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "Nに基づく：基于N。事実に基づく判断：基于事实的判断。",
      "images": []
    },
    "kosei": {
      "id": "kosei",
      "parentId": "vocabulary",
      "children": [],
      "text": "公正｜こうせい：公正、公平",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "公正ではない：并不公正。",
      "images": []
    },
    "hihan": {
      "id": "hihan",
      "parentId": "vocabulary",
      "children": [],
      "text": "批判｜ひはん：批评、批判",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "〜と批判する：批评称……。",
      "images": []
    },
    "shomei": {
      "id": "shomei",
      "parentId": "vocabulary",
      "children": [],
      "text": "照明｜しょうめい：照明、灯光",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "赛场、舞台、道路等的灯光。",
      "images": []
    },
    "fukkyu": {
      "id": "fukkyu",
      "parentId": "vocabulary",
      "children": [],
      "text": "復旧｜ふっきゅう：恢复、修复",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "照明が復旧する：照明恢复。常用于设备、交通、通信。",
      "images": []
    },
    "fuseiritsu": {
      "id": "fuseiritsu",
      "parentId": "vocabulary",
      "children": [],
      "text": "不成立｜ふせいりつ：不成立、无效",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "比赛语境中指结果不被承认为有效成立。",
      "images": []
    },
    "zengaku": {
      "id": "zengaku",
      "parentId": "vocabulary",
      "children": [],
      "text": "全額｜ぜんがく：全额",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "全額払い戻す：全额退还。",
      "images": []
    },
    "haraimodosu": {
      "id": "haraimodosu",
      "parentId": "vocabulary",
      "children": [],
      "text": "払い戻す｜はらいもどす：退还、退款",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "名词：払い戻し。常用于票款、费用、投注金。",
      "images": []
    },
    "kaisai": {
      "id": "kaisai",
      "parentId": "vocabulary",
      "children": [],
      "text": "開催｜かいさい：举办、举行",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "レースの開催：比赛的举办。",
      "images": []
    },
    "toriyameru": {
      "id": "toriyameru",
      "parentId": "vocabulary",
      "children": [],
      "text": "取りやめる｜とりやめる：取消、中止",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "取消原定事项。開催を取りやめる：取消举办。",
      "images": []
    },
    "grammar": {
      "id": "grammar",
      "parentId": "jp-root",
      "children": [
        "temiru",
        "naitoikenai",
        "tekureru",
        "teshimau",
        "younimieru",
        "kamoshirenai",
        "nanda",
        "monode",
        "nomi",
        "tosareru",
        "kotokara",
        "nokadouka",
        "nodarouka",
        "toshiteno",
        "wobtosuru",
        "nimotodzuku",
        "nitsuite",
        "toshite-quote",
        "tohihansuru",
        "toiukotodesu",
        "de-renketsu",
        "renyoukei-connection"
      ],
      "text": "语法",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "temiru": {
      "id": "temiru",
      "parentId": "grammar",
      "children": [],
      "text": "～てみる：试着做……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "リサーチしてみる：试着调查一下",
      "images": []
    },
    "naitoikenai": {
      "id": "naitoikenai",
      "parentId": "grammar",
      "children": [],
      "text": "～ないといけない：必须……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "如果不做就不行；口语：～ないと／～なきゃ",
      "images": []
    },
    "tekureru": {
      "id": "tekureru",
      "parentId": "grammar",
      "children": [],
      "text": "～てくれる：别人为我方做某事",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "聞いてくれてサンキュー：谢谢你问我／听我说",
      "images": []
    },
    "teshimau": {
      "id": "teshimau",
      "parentId": "grammar",
      "children": [],
      "text": "～てしまう：不由得……／做完了",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "口语：～ちゃう；興奮してしまって → 興奮しちゃって",
      "images": []
    },
    "younimieru": {
      "id": "younimieru",
      "parentId": "grammar",
      "children": [],
      "text": "～ように見える：看起来像……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "ふざけてるように見える：看起来像在开玩笑",
      "images": []
    },
    "kamoshirenai": {
      "id": "kamoshirenai",
      "parentId": "grammar",
      "children": [],
      "text": "～かもしれない：也许、可能",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "nanda": {
      "id": "nanda",
      "parentId": "grammar",
      "children": [],
      "text": "～んだ／～なんだ：解释或强调",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "この想いは本気なんだ：这份心意是认真的。なぜ～んだね：追问理由，带审视或质问语气。",
      "images": []
    },
    "monode": {
      "id": "monode",
      "parentId": "grammar",
      "children": [],
      "text": "～もので：委婉说明原因",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "口语形式：～もんで",
      "images": []
    },
    "nomi": {
      "id": "nomi",
      "parentId": "grammar",
      "children": [],
      "text": "～のみ：仅、只",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "比だけ更书面、正式。日本国内でのみ有効：只在日本国内有效。",
      "images": []
    },
    "tosareru": {
      "id": "tosareru",
      "parentId": "grammar",
      "children": [],
      "text": "～とされる：被认为是、被视为",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "常见于新闻、法律、论文。例：有効とされる：被认为有效。",
      "images": []
    },
    "kotokara": {
      "id": "kotokara",
      "parentId": "grammar",
      "children": [],
      "text": "～ことから：由于、基于……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "书面说明原因或判断依据。例：サーバーがアメリカにあることから。",
      "images": []
    },
    "nokadouka": {
      "id": "nokadouka",
      "parentId": "grammar",
      "children": [],
      "text": "～のかどうか：是否……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "把疑问内容名词化。効力が及ぶのかどうか：效力是否及于。",
      "images": []
    },
    "nodarouka": {
      "id": "nodarouka",
      "parentId": "grammar",
      "children": [],
      "text": "～のだろうか：究竟是否……呢",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "带沉思、怀疑或反问感。意義はあるのだろうか：真的有意义吗？",
      "images": []
    },
    "toshiteno": {
      "id": "toshiteno",
      "parentId": "grammar",
      "children": [],
      "text": "NとしてのN：作为……的……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "人間としての価値：作为人的价值。教師としての責任：作为教师的责任。",
      "images": []
    },
    "wobtosuru": {
      "id": "wobtosuru",
      "parentId": "grammar",
      "children": [],
      "text": "AをBとする：把A视为B、认定为B",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "このレースを不成立として：将这场比赛认定为不成立。",
      "images": []
    },
    "nimotodzuku": {
      "id": "nimotodzuku",
      "parentId": "grammar",
      "children": [],
      "text": "Nに基づく：基于N",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "政治的な動機に基づくもの：基于政治动机的行为。",
      "images": []
    },
    "nitsuite": {
      "id": "nitsuite",
      "parentId": "grammar",
      "children": [],
      "text": "Nについて：关于、针对N",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "日本の対応について批判する：针对日本的应对进行批评。",
      "images": []
    },
    "toshite-quote": {
      "id": "toshite-quote",
      "parentId": "grammar",
      "children": [],
      "text": "～として：称……、认为……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "「政治的な動機に基づくものだ」として：称其基于政治动机。",
      "images": []
    },
    "tohihansuru": {
      "id": "tohihansuru",
      "parentId": "grammar",
      "children": [],
      "text": "～と批判する：批评称……",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "公正ではないと批判する：批评称并不公正。",
      "images": []
    },
    "toiukotodesu": {
      "id": "toiukotodesu",
      "parentId": "grammar",
      "children": [],
      "text": "～ということです：据称、报道称",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "新闻转述句尾，表示消息来自相关方面或报道。",
      "images": []
    },
    "de-renketsu": {
      "id": "de-renketsu",
      "parentId": "grammar",
      "children": [],
      "text": "NはAで、B：判断句连接",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "賞味期限はことし12月で、続く2文字がJR：期限是12月，且后续字符是JR。",
      "images": []
    },
    "renyoukei-connection": {
      "id": "renyoukei-connection",
      "parentId": "grammar",
      "children": [],
      "text": "动词连用形连接：动作并列",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "対応をとり、開催も取りやめた：采取应对措施，并取消举办。",
      "images": []
    },
    "conjugation": {
      "id": "conjugation",
      "parentId": "jp-root",
      "children": [
        "kuru"
      ],
      "text": "动词变形",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "kuru": {
      "id": "kuru",
      "parentId": "conjugation",
      "children": [
        "kita",
        "kite",
        "konai",
        "kimasu"
      ],
      "text": "来る｜くる：不规则动词",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "变形时读音会变化",
      "images": []
    },
    "kita": {
      "id": "kita",
      "parentId": "kuru",
      "children": [],
      "text": "来た｜きた：来了",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "kite": {
      "id": "kite",
      "parentId": "kuru",
      "children": [],
      "text": "来て｜きて：て形",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "konai": {
      "id": "konai",
      "parentId": "kuru",
      "children": [],
      "text": "来ない｜こない：不来",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "kimasu": {
      "id": "kimasu",
      "parentId": "kuru",
      "children": [],
      "text": "来ます｜きます：礼貌形",
      "tags": [],
      "collapsed": false,
