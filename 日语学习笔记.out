      "id": "kuru",
      "parentId": "conjugation",
      "children": [
        "kita",
        "kite",
        "konai",
        "kimasu"
      ],
      "text": "来る（くる）：不规则动词",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "变形时读音会变化",
      "images": []
    },
    "kita": {
      "id": "kita",
      "parentId": "kuru",
      "children": [],
      "text": "来た（きた）：来了",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "kite": {
      "id": "kite",
      "parentId": "kuru",
      "children": [],
      "text": "来て（きて）：て形",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "konai": {
      "id": "konai",
      "parentId": "kuru",
      "children": [],
      "text": "来ない（こない）：不来",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "kimasu": {
      "id": "kimasu",
      "parentId": "kuru",
      "children": [],
      "text": "来ます（きます）：礼貌形",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "sentences": {
      "id": "sentences",
      "parentId": "jp-root",
      "children": [
        "sentence-value",
        "sentence-human-value",
        "sentence-neighborhood",
        "sentence-research",
