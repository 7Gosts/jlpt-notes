    },
    "sentence-value": {
      "id": "sentence-value",
      "parentId": "sentences",
      "children": [],
      "text": "価値がなければ、生きていても意味がない。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "如果没有价值，即使活着也没有意义。～なければ／～ても",
      "images": []
    },
    "sentence-human-value": {
      "id": "sentence-human-value",
      "parentId": "sentences",
      "children": [],
      "text": "克服できない僕に、人間としての価値はあるのか？",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "无法克服它的我，还有作为人的价值吗？",
      "images": []
    },
    "sentence-neighborhood": {
      "id": "sentence-neighborhood",
      "parentId": "sentences",
      "children": [],
      "text": "ちょうど近所まで来たもので、これどうぞ。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "正好来到附近，这个请收下。来た读作きた。",
      "images": []
    },
    "sentence-research": {
      "id": "sentence-research",
      "parentId": "sentences",
      "children": [],
      "text": "ちょっとリサーチしてみるよ。……この想いは本気なんだ。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "表现得像在开玩笑，但这份感情是认真的。",
      "images": []
    },
    "sentence-patent-fc2": {
      "id": "sentence-patent-fc2",
      "parentId": "sentences",
      "children": [],
      "text": "特許権は、日本国内でのみ有効とされる「属地主義」がとられ、FC2のサーバーがアメリカにあることから、効力が及ぶのかどうかが争点になりました。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "假名：とっきょけんは、にほんこくないでのみゆうこうとされる「ぞくちしゅぎ」がとられ、エフシーツーのサーバーがアメリカにあることから、こうりょくがおよぶのかどうかがそうてんになりました。译：专利权采取只在日本国内有效的属地主义；因FC2服务器在美国，效力是否适用成为争议焦点。重点：～でのみ、～とされる、～ことから、～のかどうか、効力が及ぶ。",
      "images": []
    },
    "sentence-enmei-sei": {
      "id": "sentence-enmei-sei",
      "parentId": "sentences",
      "children": [],
      "text": "わずかばかりの延命に、意義はあるのだろうか。君はなぜ、そんなわずかばかりの「生」にしがみつくんだね？",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "假名：わずかばかりのえんめいに、いぎはあるのだろうか。きみはなぜ、そんなわずかばかりの「せい」にしがみつくんだね？译：仅仅多延续那么一点生命，真的有意义吗？你为什么要执着于那样微不足道的一点「生」呢？重点：わずかばかり带轻视感；～のだろうか有怀疑反问；なぜ～んだね追问理由。",
      "images": []
    },
    "culture": {
      "id": "culture",
      "parentId": "jp-root",
      "children": [
        "three-slopes"
      ],
      "text": "文化与趣味表达",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "",
      "images": []
    },
    "three-slopes": {
      "id": "three-slopes",
      "parentId": "culture",
      "children": [],
      "text": "人生には三つの坂があるんですって。上り坂、下り坂、まさか。",
      "tags": [],
      "collapsed": false,
      "checked": null,
      "subtext": "坂（さか）与まさか（没想到）的谐音",
      "images": []
    }
  },
